{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,

    "forceConsistentCasingInFileNames": true, // remove later
    "paths": {
      "contentlayer/generated": ["./.contentlayer/generated"], // remove later
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true, // remove later
    "noUnusedLocals": true, // remove later
    "noUnusedParameters": true, // remove later
    "noImplicitReturns": true, // remove later
    "noFallthroughCasesInSwitch": true // remove later
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".contentlayer/generated", // remove later
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
