#!/usr/bin/env bash
#
# Full gate before anything leaves the machine. Runs the same script CI runs,
# so a push that passes here passes on GitHub.
#
# Bypass with `git push --no-verify`.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Git feeds one line per ref on stdin:
#   <local ref> <local oid> <remote ref> <remote oid>
# A deletion has an all-zero local oid. Pushing nothing but deletions ships no
# code, so linting and building for it is pure latency — skip straight through.
has_content=0
while read -r _local_ref local_oid _remote_ref _remote_oid; do
  [[ -z "${local_oid:-}" ]] && continue
  if [[ "$local_oid" =~ ^0+$ ]]; then
    continue
  fi
  has_content=1
done

if [[ $has_content -eq 0 ]]; then
  printf '\033[2m▶ deletion-only push — skipping gate\033[0m\n'
  exit 0
fi

exec ./scripts/ci-local.sh
